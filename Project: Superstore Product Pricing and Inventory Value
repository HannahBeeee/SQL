-- What information is available in the dataset?

SELECT *
FROM superstore
LIMIT 5
;


-- 1. How do product prices compare from lowest to highest?

SELECT item_name
    , ROUND(price, 2) AS price
FROM superstore
ORDER BY price ASC
;


-- 2. What is the average price of products in the store?

SELECT ROUND(AVG(price), 2) AS average_price
FROM superstore
;


-- 3. What is the highest product price in the Kitchen Supplies category?

SELECT ROUND(MAX(price), 2) AS highest_kitchen_price
FROM superstore
WHERE category = 'Kitchen Supplies'
;


-- 4. What is the total dollar value of all inventory currently in stock?

SELECT ROUND(SUM(price * stock_quantity), 2) AS total_inventory_value
FROM superstore
;


-- 5. Which products contribute the most to total inventory value?

SELECT item_name
    , ROUND(price, 2) AS price
    , stock_quantity
    , ROUND(price * stock_quantity, 2) AS total_stock_value
FROM superstore
ORDER BY total_stock_value DESC
;


-- Findings:
-- The dataset includes 15 products across four categories.
-- The average product price is $142.35.
-- Product prices range from $24.99 to $549.00.
-- The highest-priced Kitchen Supplies item costs $89.99.
-- The total inventory value is $68,117.60.
--
-- The Memory Foam Mattress contributes the highest inventory
-- value at $14,999.70, followed by the Smart LED TV at $10,980.00.
-- The Robot Vacuum Cleaner ranks third at $7,980.00.
--
-- These findings demonstrate how product prices and stock
-- quantities contribute to overall inventory value.
-- Products with higher prices or larger stock quantities
-- can represent a greater share of the store's inventory value.
