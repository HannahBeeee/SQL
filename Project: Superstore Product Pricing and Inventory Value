
-- Project Title:
-- Superstore Product Pricing and Inventory Value

-- Overall Research Question:
-- How do product prices vary across the store, and what is
-- the total financial value of inventory currently in stock?


-- Create the Superstore dataset

CREATE TABLE superstore (
    item_id INTEGER PRIMARY KEY,
    item_name TEXT,
    category TEXT,
    price DECIMAL(10, 2),
    stock_quantity INTEGER,
    average_rating DECIMAL(3, 2)
);


